# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser enviado ao Git (ja esta no .gitignore).

# --- Banco de dados (usado pelo docker-compose) ---
POSTGRES_DB=ecotrack
POSTGRES_USER=ecotrack
POSTGRES_PASSWORD=troque-esta-senha

# --- Portas expostas no seu computador ---
APP_PORT=8080
DB_PORT=5432

# --- Opcional: rodar a API fora do Docker (./mvnw spring-boot:run) ---
# Exporte estas variaveis no terminal antes de iniciar a aplicacao:
# DATABASE_URL=jdbc:postgresql://localhost:5432/ecotrack
# DATABASE_USER=ecotrack
# DATABASE_PWD=troque-esta-senha
